<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <!-- Override PDFsharp's vulnerable PKCS dependency. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="HelveticaMetrics.json" />
    <EmbeddedResource Include="Fonts/Cinzel-ExtraBold.ttf" />
    <EmbeddedResource Include="Fonts/LibreBaskerville-Regular.ttf" />
    <EmbeddedResource Include="Fonts/LibreBaskerville-Bold.ttf" />
    <None Update="Fonts/OFL-Cinzel.txt" Pack="true" PackagePath="licenses/" />
    <None Update="Fonts/OFL-LibreBaskerville.txt" Pack="true" PackagePath="licenses/"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
